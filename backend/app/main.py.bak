def model_to_dict(obj, fields):
    return {
        f: getattr(obj, f)
        for f in fields
    }


# ---------------------------------------------------------------------------
# Global search
# ---------------------------------------------------------------------------

@app.get("/api/search")
def global_search(q: str = Query(..., min_length=1, max_length=200), limit: int = Query(100, ge=1, le=200)):
    term = q.strip()
    if not term:
        return {"query": q, "results": []}

    like = f"%{term}%"
    results = []

    def add_rows(rows, resource, label_fn, value_fn):
        for row in rows:
            if len(results) >= limit:
                break
            results.append({
                "resource": resource,
                "id": getattr(row, "id", None),
                "scan_id": getattr(row, "scan_id", None),
                "label": label_fn(row),
                "value": value_fn(row),
            })

    with SessionLocal() as db:
        # Scans / targets
        rows = db.scalars(
            select(Scan)
            .join(Target, Scan.target_id == Target.id)
            .where(or_(
                Target.canonical.ilike(like),
                Scan.scan_type.ilike(like),
                Scan.status.ilike(like),
                Scan.current_stage.ilike(like),
            ))
            .order_by(Scan.created_at.desc())
            .limit(limit)
        ).all()
        add_rows(
            rows, "scans",
            lambda x: x.target.canonical if x.target else x.id,
            lambda x: f"{x.scan_type} Â· {x.status}",
        )

        # Subdomains
        if len(results) < limit:
            rows = db.scalars(
                select(Subdomain).where(
                    Subdomain.fqdn.ilike(like)
                ).order_by(Subdomain.id).limit(limit)
            ).all()
            add_rows(rows, "subdomains", lambda x: x.fqdn, lambda x: "Subdomain")

        # Alive Web
        if len(results) < limit:
            rows = db.scalars(
                select(WebService).where(or_(
                    WebService.url.ilike(like),
                    WebService.title.ilike(like),
                    WebService.ip.ilike(like),
                    WebService.waf_name.ilike(like),
                    cast(WebService.technologies, String).ilike(like),
                )).order_by(WebService.id).limit(limit)
            ).all()
            add_rows(
                rows, "alive",
                lambda x: x.url,
                lambda x: f"{x.status_code or 'â€”'} Â· {x.waf_name or 'No WAF recorded'}",
            )

        # Infrastructure / IPs
        if len(results) < limit:
            rows = db.scalars(
                select(InfrastructureIP).where(or_(
                    InfrastructureIP.ip.ilike(like),
                    cast(InfrastructureIP.hostnames, String).ilike(like),
                    InfrastructureIP.cdn_name.ilike(like),
                    InfrastructureIP.waf_name.ilike(like),
                )).order_by(InfrastructureIP.id).limit(limit)
            ).all()
            add_rows(
                rows, "ips",
                lambda x: x.ip,
                lambda x: f"CDN: {x.cdn_name or 'â€”'} Â· WAF: {x.waf_name or 'â€”'}",
            )

        # Ports
        if len(results) < limit:
            rows = db.scalars(
                select(OpenPort).where(or_(
                    OpenPort.ip.ilike(like),
                    cast(OpenPort.port, String).ilike(like),
                    OpenPort.protocol.ilike(like),
                    OpenPort.service.ilike(like),
                    OpenPort.version.ilike(like),
                    OpenPort.source.ilike(like),
                )).order_by(OpenPort.id).limit(limit)
            ).all()
            add_rows(
                rows, "ports",
                lambda x: f"{x.ip}:{x.port}",
                lambda x: f"{x.protocol or 'â€”'} Â· {x.service or 'unknown'} Â· {x.version or 'â€”'}",
            )

        # Endpoints
        if len(results) < limit:
            rows = db.scalars(
                select(Endpoint).where(or_(
                    Endpoint.url.ilike(like),
                    Endpoint.source.ilike(like),
                    Endpoint.method.ilike(like),
                    Endpoint.kind.ilike(like),
                    cast(Endpoint.status_code, String).ilike(like),
                )).order_by(Endpoint.id).limit(limit)
            ).all()
            add_rows(rows, "endpoints", lambda x: x.url, lambda x: f"{x.method or 'â€”'} Â· {x.status_code or 'â€”'}")

        # Secrets
        if len(results) < limit:
            rows = db.scalars(
                select(Secret).where(or_(
                    Secret.source.ilike(like),
                    Secret.kind.ilike(like),
                    Secret.location.ilike(like),
                    Secret.value_masked.ilike(like),
                    Secret.severity.ilike(like),
                )).order_by(Secret.id).limit(limit)
            ).all()
            add_rows(rows, "secrets", lambda x: x.location or x.kind, lambda x: f"{x.kind} Â· {x.severity or 'â€”'}")

        # Findings
        if len(results) < limit:
            rows = db.scalars(
                select(Finding).where(or_(
                    Finding.name.ilike(like),
                    Finding.tool.ilike(like),
                    Finding.severity.ilike(like),
                    Finding.target.ilike(like),
                    Finding.status.ilike(like),
                )).order_by(Finding.id).limit(limit)
            ).all()
            add_rows(rows, "findings", lambda x: x.name, lambda x: f"{x.tool or 'â€”'} Â· {x.severity or 'â€”'} Â· {x.target or 'â€”'}")

        # Changes
        if len(results) < limit:
            rows = db.scalars(
                select(Change).where(or_(
                    Change.change_type.ilike(like),
                    Change.asset.ilike(like),
                    Change.previous_value.ilike(like),
                    Change.current_value.ilike(like),
                )).order_by(Change.id.desc()).limit(limit)
            ).all()
            add_rows(rows, "changes", lambda x: x.asset, lambda x: f"{x.change_type} Â· {x.current_value or 'â€”'}")

        # FFUF runs
        if len(results) < limit:
            rows = db.scalars(
                select(FFUFRuns).where(or_(
                    FFUFRuns.subdomain.ilike(like),
                    FFUFRuns.url.ilike(like),
                    FFUFRuns.status.ilike(like),
                    FFUFRuns.output.ilike(like),
                    FFUFRuns.error.ilike(like),
                )).order_by(FFUFRuns.created_at.desc()).limit(limit)
            ).all()
            add_rows(rows, "ffuf", lambda x: x.url, lambda x: f"{x.status} Â· {x.subdomain or 'â€”'}")

        return {"query": term, "results": results[:limit]}

# ---------------------------------------------------------------------------
# Scan resources
# ---------------------------------------------------------------------------
@app.get("/api/scans/{scan_id}/{resource}")
def resource_list(
    scan_id: str,
    resource: str,
    page: int = Query(1, ge=1),
    limit: int = Query(100, ge=1, le=500),
):
    if resource not in RESOURCE_MAP:
        raise HTTPException(404, "Unknown resource")

    model, fields = RESOURCE_MAP[resource]

    with SessionLocal() as db:
        if not db.get(Scan, scan_id):
            raise HTTPException(404, "Scan not found")

        base_query = select(model).where(
            getattr(model, "scan_id") == scan_id
        )

        total = (
            db.scalar(
                select(func.count())
                .select_from(model)
                .where(getattr(model, "scan_id") == scan_id)
            )
            or 0
        )

        rows = db.scalars(
            base_query
            .order_by(model.id)
            .offset((page - 1) * limit)
            .limit(limit)
        ).all()

        return {
            "items": [
                model_to_dict(row, fields)
                for row in rows
            ],
            "page": page,
            "limit": limit,
            "total": total,
            "pages": (
                (total + limit - 1) // limit
                if total
                else 0
            ),
        }
# ---------------------------------------------------------------------------
# Export resources
# ---------------------------------------------------------------------------

@app.get("/api/scans/{scan_id}/export/{resource}.{fmt}")
def export_resource(
    scan_id: str,
    resource: str,
    fmt: str,
):
    if resource not in RESOURCE_MAP or fmt not in {
        "json",
        "txt",
    }:
        raise HTTPException(
            404,
            "Unknown export",
        )

    model, fields = RESOURCE_MAP[resource]

    with SessionLocal() as db:
        rows = db.scalars(
            select(model)
            .where(
                getattr(model, "scan_id") == scan_id
            )
            .order_by(model.id)
        ).all()

        data = [
            model_to_dict(x, fields)
            for x in rows
        ]

    if fmt == "json":
        return StreamingResponse(
            iter(
                [
                    json.dumps(
                        data,
                        default=str,
                        indent=2,
                    )
                ]
            ),
            media_type="application/json",
            headers={
                "Content-Disposition":
                    f'attachment; filename="{resource}.json"'
            },
        )

    lines = []

    for row in data:
        values = [
            str(row.get(f, ""))
            for f in fields
        ]
        lines.append(
            "\t".join(values)
        )

    return PlainTextResponse(
        "\n".join(lines),
        headers={
            "Content-Disposition":
                f'attachment; filename="{resource}.txt"'
        },
    )


# ---------------------------------------------------------------------------
# Wordlists
# ---------------------------------------------------------------------------

@app.get(
    "/api/wordlists",
    response_model=list[WordlistOut],
)
def list_wordlists():
    with SessionLocal() as db:
        rows = db.scalars(
            select(Wordlist)
            .order_by(Wordlist.name)
        ).all()

        custom = [
            WordlistOut.model_validate(x)
            for x in rows
        ]

    # Built-in SecLists are read-only tool assets,
    # not scan artifacts.
    seclists = Path("/opt/seclists")
    builtin = []

    if seclists.exists():
        for p in sorted(
            seclists.rglob("*.txt")
        ):
            rel = p.relative_to(
                seclists
            ).as_posix()

            pseudo_id = (
                f"builtin:{rel}"
            )

            builtin.append(
                {
                    "id": pseudo_id,
                    "name": f"SecLists / {rel}",
                    "source": "seclists",
                }
            )

    return custom + builtin


@app.post(
    "/api/wordlists/custom",
    response_model=WordlistOut,
)
async def upload_wordlist(
    file: UploadFile = File(...),
):
    content = await file.read()

    if len(content) > 50 * 1024 * 1024:
        raise HTTPException(
            413,
            "Wordlist too large (max 50 MB)",
        )

    with SessionLocal() as db:
        row = Wordlist(
            name=file.filename or "custom.txt",
            source="custom",
            content=content,
        )

        db.add(row)
        db.commit()
        db.refresh(row)

        return WordlistOut.model_validate(
            row
        )


# ---------------------------------------------------------------------------
# FFUF
# ---------------------------------------------------------------------------

@app.post(
    "/api/ffuf-runs",
    response_model=FFUFOut,
)
def create_ffuf_run(
    payload: FFUFCreate,
):
    with SessionLocal() as db:
        scan = db.get(
            Scan,
            payload.scan_id,
        )

        if not scan:
            raise HTTPException(
                404,
                "Scan not found",
            )

      
        host = (
            urlparse(
                payload.url
            ).hostname
            or ""
        ).lower()

        if not in_scope(
            host,
            scan.target.canonical,
        ):
            raise HTTPException(
                400,
                "FFUF target is outside the scan target",
            )

        if payload.subdomain:
            sub = db.scalar(
                select(Subdomain).where(
                    Subdomain.scan_id == payload.scan_id,
                    Subdomain.fqdn == payload.subdomain,
                )
            )

            if not sub:
                raise HTTPException(
                    400,
                    "Selected subdomain is not part of this scan",
                )

        mode = payload.mode.lower().strip()

        if mode not in {
            "path",
            "parameter",
            "header",
            "body",
        }:
            raise HTTPException(
                400,
                "Invalid FFUF mode",
            )

        if (
            mode in {"path", "parameter"}
            and "FUZZ" not in payload.url
        ):
            raise HTTPException(
                400,
                "URL must contain FUZZ for path/parameter mode",
            )

        if (
            mode == "header"
            and not any(
                "FUZZ" in str(v)
                for v in payload.headers.values()
            )
        ):
            raise HTTPException(
                400,
                "At least one header value must contain FUZZ",
            )

        if (
            mode == "body"
            and (
                not payload.body
                or "FUZZ" not in payload.body
            )
        ):
            raise HTTPException(
                400,
                "Body must contain FUZZ",
            )

        wordlist_id = payload.wordlist_id

        if wordlist_id.startswith(
            "builtin:"
        ):
            name = wordlist_id.removeprefix(
                "builtin:"
            )

            path = (
                Path("/opt/seclists")
                / name
            )

            if (
                not path.exists()
                or not path.is_file()
            ):
                raise HTTPException(
                    404,
                    "Built-in wordlist not found",
                )

            row = db.scalar(
                select(Wordlist).where(
                    Wordlist.name
                    == f"SecLists / {name}",
                    Wordlist.source
                    == "seclists",
                )
            )

            if not row:
                row = Wordlist(
                    name=f"SecLists / {name}",
                    source="seclists",
                    content=path.read_bytes(),
                )

                db.add(row)
                db.flush()

            wordlist_id = row.id

        if not db.get(
            Wordlist,
            wordlist_id,
        ):
            raise HTTPException(
                404,
                "Wordlist not found",
            )

        config = payload.model_dump()
        config["wordlist_id"] = wordlist_id

        run = FFUFRuns(
            scan_id=payload.scan_id,
            subdomain=payload.subdomain,
            url=payload.url,
            config=config,
        )

        db.add(run)
        db.commit()
        db.refresh(run)

        enqueue_ffuf(run.id)

        return FFUFOut.model_validate(
            run
        )


@app.post(
    "/api/ffuf-runs/{run_id}/stop",
    response_model=FFUFOut,
)
def stop_ffuf_run(
    run_id: str,
):
    with SessionLocal() as db:
        run = db.get(
            FFUFRuns,
            run_id,
        )

        if not run:
            raise HTTPException(
                404,
                "FFUF run not found",
            )

        if run.status in {
            "completed",
            "failed",
            "cancelled",
        }:
            return FFUFOut.model_validate(run)

        if run.status == "stopping":
            return FFUFOut.model_validate(run)

        if run.status == "queued":
            run.status = "cancelled"
            run.error = "FFUF stopped by user before execution"
            run.finished_at = datetime.now(timezone.utc)
        else:
            run.status = "stopping"
            run.error = "FFUF stop requested by user"

        db.commit()
        db.refresh(run)

        return FFUFOut.model_validate(run)


@app.get(
    "/api/ffuf-runs/{run_id}",
    response_model=FFUFOut,
)
def get_ffuf_run(
    run_id: str,
):
    with SessionLocal() as db:
        run = db.get(
            FFUFRuns,
            run_id,
        )

        if not run:
            raise HTTPException(
                404,
                "FFUF run not found",
            )

        return FFUFOut.model_validate(
            run
        )


@app.get(
    "/api/ffuf-runs/{run_id}/stream"
)
async def ffuf_stream(
    run_id: str,
):

    async def generator():
        last_count = 0

        while True:
            with SessionLocal() as db:
                run = db.get(
                    FFUFRuns,
                    run_id,
                )

                if not run:
                    return

                events = db.scalars(
                    select(FFUFEvent)
                    .where(
                        FFUFEvent.ffuf_run_id == run_id,
                        FFUFEvent.seq > last_count,
                    )
                    .order_by(FFUFEvent.seq)
                ).all()

                for event in events:
                    yield (
                        f"data: "
                        f"{json.dumps({'seq': event.seq, 'line': event.line})}"
                        "\n\n"
                    )

                    last_count = event.seq

                if run.status in {
                    "completed",
                    "failed",
                    "cancelled",
                }:
                    yield (
                        "event: done\n"
                        f"data: {json.dumps({'status': run.status, 'error': run.error})}"
                        "\n\n"
                    )
                    return

            await asyncio.sleep(0.5)

    return StreamingResponse(
        generator(),
        media_type="text/event-stream",
        headers={
            "Cache-Control": "no-cache",
            "X-Accel-Buffering": "no",
        },
    )


# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------

@app.websocket("/ws/scans/{scan_id}")
async def scan_ws(
    websocket: WebSocket,
    scan_id: str,
):
    await websocket.accept()

    try:
        while True:
            with SessionLocal() as db:
                scan = db.get(
                    Scan,
                    scan_id,
                )

                if not scan:
                    await websocket.send_json(
                        {"error": "not found"}
                    )
                    return

                await websocket.send_json(
                    {
                        "status": scan.status,
                        "progress": scan.progress,
                        "stage": scan.current_stage,
                    }
                )

                if scan.status in {
                    "completed",
                    "completed_with_warnings",
                    "failed",
                    "cancelled",
                }:
                    return

            await asyncio.sleep(1)

    except WebSocketDisconnect:
        return






# ---------------------------------------------------------------------------
# Nmap
# ---------------------------------------------------------------------------

@app.post("/api/nmap-runs")
def create_nmap_run(payload: dict):
    from .models import NmapRun
    from .nmap_service import normalize_config
    from .queue import redis_client, JOB_QUEUE
    from urllib.parse import urlparse
    import json

    scan_id = str(
        payload.get("scan_id") or ""
    ).strip()

    target = str(
        payload.get("target") or ""
    ).strip()

    if not scan_id:
        raise HTTPException(
            400,
            "scan_id is required",
        )

    if not target:
        raise HTTPException(
            400,
            "target is required",
        )

    with SessionLocal() as db:

        scan = db.get(
            Scan,
            scan_id,
        )

        if not scan:
            raise HTTPException(
                404,
                "Scan not found",
            )

        try:
            config = normalize_config(
                payload.get("config") or {}
            )
        except ValueError as exc:
            raise HTTPException(
                400,
                str(exc),
            )

        parsed = urlparse(
            target
            if "://" in target
            else f"https://{target}"
        )

        host = (
            parsed.hostname
            or target
        ).lower().rstrip(".")

        root = (
            scan.target.canonical
            or ""
        ).lower().rstrip(".")

        allowed = (
            host == root
            or host.endswith(
                "." + root
            )
        )

        # Exact IP target support.
        try:
            allowed = allowed or (
                ipaddress.ip_address(host)
                == ipaddress.ip_address(root)
            )
        except ValueError:
            pass

        if not allowed:
            raise HTTPException(
                400,
                "Nmap target must remain within the selected scan scope",
            )

        run = NmapRun(
            scan_id=scan.id,
            target=host,
            config=config,
            status="queued",
        )

        db.add(run)
        db.commit()
        db.refresh(run)

        redis_client.rpush(
            JOB_QUEUE,
            json.dumps(
                {
                    "type": "nmap",
                    "run_id": run.id,
                }
            ),
        )

        return {
            "id": run.id,
            "scan_id": run.scan_id,
            "target": run.target,
            "config": run.config,
            "command": run.command,
            "status": run.status,
            "output": run.output,
            "results": run.results,
            "exit_code": run.exit_code,
            "error": run.error,
            "created_at": run.created_at,
            "started_at": run.started_at,
            "finished_at": run.finished_at,
        }


@app.get("/api/nmap-runs/{run_id}")
def get_nmap_run(run_id: str):
    from .models import NmapRun

    with SessionLocal() as db:

        run = db.get(
            NmapRun,
            run_id,
        )

        if not run:
            raise HTTPException(
                404,
                "Nmap run not found",
            )

        ports = db.scalars(
            select(OpenPort)
            .where(
                OpenPort.scan_id == run.scan_id
            )
            .order_by(
                OpenPort.ip,
                OpenPort.port,
            )
        ).all()

        nmap_ports = [
            {
                "ip": p.ip,
                "port": p.port,
                "protocol": p.protocol,
                "service": p.service,
                "version": p.version,
                "source": p.source,
            }
            for p in ports
            if "nmap" in str(
                p.source or ""
            ).lower().split(",")
        ]

        return {
            "id": run.id,
            "scan_id": run.scan_id,
            "target": run.target,
            "config": run.config,
            "command": run.command,
            "status": run.status,
            "output": run.output,
            "xml_output": run.xml_output,
            "results": run.results or [],
            "ports": nmap_ports,
            "exit_code": run.exit_code,
            "error": run.error,
            "created_at": run.created_at,
            "started_at": run.started_at,
            "finished_at": run.finished_at,
        }


@app.get("/api/scans/{scan_id}/nmap-runs")
def list_nmap_runs(scan_id: str):
    from .models import NmapRun

    with SessionLocal() as db:

        scan = db.get(
            Scan,
            scan_id,
        )

        if not scan:
            raise HTTPException(
                404,
                "Scan not found",
            )

        runs = db.scalars(
            select(NmapRun)
            .where(
                NmapRun.scan_id == scan_id
            )
            .order_by(
                NmapRun.created_at.desc()
            )
            .limit(100)
        ).all()

        return [
            {
                "id": x.id,
                "scan_id": x.scan_id,
                "target": x.target,
                "config": x.config,
                "command": x.command,
                "status": x.status,
                "output": x.output,
                "results": x.results or [],
                "exit_code": x.exit_code,
                "error": x.error,
                "created_at": x.created_at,
                "started_at": x.started_at,
                "finished_at": x.finished_at,
            }
            for x in runs
        ]


@app.post("/api/nmap-runs/{run_id}/stop")
def stop_nmap_run(run_id: str):
    from .models import NmapRun

    with SessionLocal() as db:

        run = db.get(
            NmapRun,
            run_id,
        )

        if not run:
            raise HTTPException(
                404,
                "Nmap run not found",
            )

        if run.status in {
            "completed",
            "failed",
            "cancelled",
        }:
            return {
                "id": run.id,
                "status": run.status,
            }

        if run.status == "queued":
            run.status = "cancelled"
            run.error = (
                "Nmap stopped before execution"
            )
            run.finished_at = (
                datetime.now(timezone.utc)
            )
        else:
            run.status = "stopping"
            run.error = (
                "Nmap stop requested by user"
            )

        db.commit()

        return {
            "id": run.id,
            "status": run.status,
        }

